#: src/currens/__main__.py:15
msgid "Database initialized."
msgstr "Η βάση δεδομένων αρχικοποιήθηκε."

#: src/currens/__main__.py:18
msgid "Database recreated."
msgstr "Η βάση δεδομένων δημιουργήθηκε εκ νέου."

#: src/currens/collector/core.py:34
msgid "Initializing the database..."
msgstr "Αρχικοποίηση της βάσης δεδομένων..."

#: src/currens/collector/core.py:37
msgid "Database tables created."
msgstr "Οι πίνακες της βάσης δεδομένων δημιουργήθηκαν."

#: src/currens/collector/core.py:50
msgid "Pre-populating base currencies..."
msgstr "Προσυμπλήρωση βασικών νομισμάτων..."

#: src/currens/collector/core.py:57
#, python-brace-format
msgid "Inserted base currencies: {codes}"
msgstr "Προστέθηκαν βασικά νομίσματα: {codes}"

#: src/currens/collector/core.py:62
msgid "Base currencies already exist. Skipping pre-population."
msgstr "Τα βασικά νομίσματα υπάρχουν ήδη. Η προσυμπλήρωση παραλείπεται."

#: src/currens/collector/core.py:65
msgid "Database initialization complete."
msgstr "Η αρχικοποίηση της βάσης δεδομένων ολοκληρώθηκε."

#: src/currens/collector/core.py:72
msgid "Dropping all tables..."
msgstr "Διαγραφή όλων των πινάκων..."

#: src/currens/collector/core.py:74
msgid "All tables dropped."
msgstr "Όλοι οι πίνακες διαγράφηκαν."

#: src/currens/collector/core.py:81
#, python-brace-format
msgid ""
"Fetching exchange rates from Riksbank for currency {currency_iso_code} "
"from {start_date} to {end_date}..."
msgstr ""
"Ανάκτηση συναλλαγματικών ισοτιμιών από τη Riksbank για το νόμισμα "
"{currency_iso_code} από {start_date} έως {end_date}..."

#: src/currens/collector/core.py:87 src/currens/collector/core.py:127
msgid "today"
msgstr "σήμερα"

#: src/currens/collector/core.py:103 src/currens/collector/core.py:144
#, python-brace-format
msgid "Error fetching data: {error}"
msgstr "Σφάλμα κατά την ανάκτηση δεδομένων: {error}"

#: src/currens/collector/core.py:108
#, python-brace-format
msgid "Successfully stored exchange rates for currency {currency_iso_code}."
msgstr ""
"Οι συναλλαγματικές ισοτιμίες για το νόμισμα {currency_iso_code} "
"αποθηκεύτηκαν επιτυχώς."

#: src/currens/collector/core.py:120
#, python-brace-format
msgid ""
"Fetching exchange rates from European Central Bank for base currency "
"{base_currency_iso_code} and rate currency {rate_currency_iso_code} from "
"{start_date} to {end_date}..."
msgstr ""
"Ανάκτηση συναλλαγματικών ισοτιμιών από την Ευρωπαϊκή Κεντρική Τράπεζα για"
" νόμισμα βάσης {base_currency_iso_code} και νόμισμα ισοτιμίας "
"{rate_currency_iso_code} από {start_date} έως {end_date}..."

#: src/currens/collector/core.py:150
#, python-brace-format
msgid ""
"Successfully stored exchange rates for base currency "
"{base_currency_iso_code} and rate currency {rate_currency_iso_code}."
msgstr ""
"Οι συναλλαγματικές ισοτιμίες για νόμισμα βάσης {base_currency_iso_code} "
"και νόμισμα ισοτιμίας {rate_currency_iso_code} αποθηκεύτηκαν επιτυχώς."

#: src/currens/collector/core.py:160
#, python-brace-format
msgid "Fetched {count} records. Storing them in the database..."
msgstr "Ανακτήθηκαν {count} εγγραφές. Αποθήκευση στη βάση δεδομένων..."

